<?xml version="1.0" ?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#292D30"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#292D30"/>
            <stroke android:width="2dp" android:color="#969C9F"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#181B1D"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
</selector>
