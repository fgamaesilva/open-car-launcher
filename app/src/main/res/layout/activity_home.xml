<?xml version="1.0" ?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cockpit_bg">
    <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical" android:padding="16dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="HH:mm" android:format24Hour="HH:mm" android:textSize="40sp" android:fontFamily="sans-serif-light" android:textColor="@color/cockpit_text_primary"/>
            <TextClock android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="20dp" android:format12Hour="EEEE, dd MMMM" android:format24Hour="EEEE, dd MMMM" android:textSize="16sp" android:textColor="@color/cockpit_text_secondary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L200" android:textSize="20sp" android:letterSpacing="0.12" android:textColor="@color/cockpit_text_secondary"/>
            <ImageButton android:id="@+id/headerSettings" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginStart="12dp" android:padding="16dp" android:src="@drawable/ic_settings" android:background="@drawable/bg_l200_action" android:contentDescription="@string/l200_settings"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:baselineAligned="false" android:orientation="horizontal">
            <LinearLayout android:id="@+id/cardProjection" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="0dp" android:padding="12dp" android:gravity="center_vertical" android:orientation="vertical" android:background="@drawable/bg_l200_action" android:clickable="true" android:focusable="true" android:contentDescription="@string/l200_projection">
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_phone_link" android:contentDescription="@null"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/l200_projection" android:textSize="20sp" android:textColor="@color/cockpit_text_primary" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/subtitleProjection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/cockpit_text_secondary" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/cardNav" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="12dp" android:padding="12dp" android:gravity="center_vertical" android:orientation="vertical" android:background="@drawable/bg_l200_action" android:clickable="true" android:focusable="true" android:contentDescription="@string/l200_nav">
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_navigation" android:contentDescription="@null"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/l200_nav" android:textSize="20sp" android:textColor="@color/cockpit_text_primary" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/subtitleNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/cockpit_text_secondary" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/cardMusic" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="12dp" android:padding="12dp" android:gravity="center_vertical" android:orientation="vertical" android:background="@drawable/bg_l200_action" android:clickable="true" android:focusable="true" android:contentDescription="@string/l200_music">
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_music" android:contentDescription="@null"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/l200_music" android:textSize="20sp" android:textColor="@color/cockpit_text_primary" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/subtitleMusic" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/cockpit_text_secondary" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnRadio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_l200_action" android:drawableStart="@drawable/ic_radio" android:drawablePadding="8dp" android:paddingHorizontal="16dp" android:text="@string/l200_radio" android:textAllCaps="false" android:textSize="16sp" android:textColor="@color/cockpit_text_primary"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnAllApps" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_l200_action" android:drawableStart="@drawable/ic_apps" android:drawablePadding="8dp" android:paddingHorizontal="16dp" android:text="@string/l200_apps" android:textAllCaps="false" android:textSize="16sp" android:textColor="@color/cockpit_text_primary"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_l200_action" android:drawableStart="@drawable/ic_settings" android:drawablePadding="8dp" android:paddingHorizontal="16dp" android:text="@string/l200_settings" android:textAllCaps="false" android:textSize="16sp" android:textColor="@color/cockpit_text_primary"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/drawerContainer" android:layout_width="0dp" android:layout_height="0dp" android:background="@color/cockpit_scrim" android:clickable="true" android:focusable="true" android:orientation="vertical" android:padding="@dimen/screen_padding" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" tools:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_search" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_search"/>
                <EditText android:id="@+id/searchInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:autofillHints="" android:background="@null" android:hint="@string/search_apps" android:imeOptions="actionSearch|flagNoExtractUi" android:inputType="text" android:maxLines="1" android:minHeight="56dp" android:singleLine="true" android:textColor="@color/cockpit_text_primary" android:textColorHint="@color/cockpit_text_dim" android:textSize="@dimen/search_text"/>
            </LinearLayout>
            <ImageButton android:id="@+id/btnCloseDrawer" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginStart="8dp" android:background="@drawable/bg_dock_item" android:contentDescription="@string/close_drawer" android:src="@drawable/ic_close"/>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/appGrid" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="8dp" android:scrollbars="vertical"/>
            <TextView android:id="@+id/drawerEmpty" style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/loading_apps" android:visibility="gone"/>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
