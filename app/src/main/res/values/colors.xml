<?xml version="1.0" encoding="utf-8"?>
<!--
  Day cockpit. values-night/colors.xml defines the SAME names for the dark cockpit, so
  layouts can reference @color/cockpit_* directly and the theme switch costs nothing.
-->
<resources>
    <color name="cockpit_bg">#0B0D0E</color>
    <color name="cockpit_surface">#181B1D</color>
    <color name="cockpit_surface_alt">#292D30</color>
    <color name="cockpit_divider">#292D30</color>

    <color name="cockpit_text_primary">#D8DADC</color>
    <color name="cockpit_text_secondary">#969C9F</color>
    <color name="cockpit_text_dim">#969C9F</color>

    <color name="cockpit_accent">#D8DADC</color>
    <color name="cockpit_accent_dim">#D8DADC</color>
    <color name="cockpit_speed">#D8DADC</color>
    <color name="cockpit_badge">#D8DADC</color>

    <color name="cockpit_scrim">#0B0D0E</color>
    <color name="cockpit_ripple">#292D30</color>

    <!-- Translucent plates for text drawn over the map. -->
    <color name="cockpit_hud">#181B1D</color>
    <color name="cockpit_ok">#D8DADC</color>
    <color name="cockpit_warn">#D8DADC</color>
</resources>
